<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs scripts/refresh.sh every morning at 8:00 (after the US market's close has been
     published), or at the next wake if the Mac was asleep. Install: npm run refresh:install (fills in this folder's path) -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hopeboard.refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HOPEBOARD__/scripts/refresh.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
</dict>
</plist>
